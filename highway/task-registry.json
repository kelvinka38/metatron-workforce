    "host-disk-cleanup": {
      "name": "Bounded production host disk cleanup",
      "command": [
        "bash",
        "scripts/highway-tasks/host-disk-cleanup.sh"
      ],
      "resources": [
        {
          "name": "source-release:{source_sha}",
          "mode": "READ"
        },
        {
          "name": "host:storage",
          "mode": "WRITE"
        }
      ],
      "timeout_seconds": 600,
      "max_attempts": 1,
      "priority": 20
    },

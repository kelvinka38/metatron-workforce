    check_keys(a,[]); return sh_fixed("systemctl is-enabled cloudflared-mcp-hetzner.service 2>/dev/null || true; systemctl is-active cloudflared-mcp-hetzner.service 2>/dev/null || true; systemctl show cloudflared-mcp-hetzner.service -p MainPID -p ActiveState -p SubState --no-pager 2>/dev/null || true")

def op_legacy_mcp_tunnel_connector_retire(a):
    check_keys(a,[]); r=run(["/usr/bin/systemctl","disable","--now","cloudflared-mcp-hetzner.service"],timeout=120); s=run(["/usr/bin/systemctl","is-active","cloudflared-mcp-hetzner.service"])
    return {"ok":r["ok"],"exitCode":r["exitCode"],"stdout":r["stdout"]+s["stdout"],"stderr":r["stderr"]+s["stderr"]}

def op_ssh_mcp_upgrade_status(a):
    check_keys(a,[]); p="/var/log/metatron-ssh-mcp-upgrade.log"
    try: data=open(p,"rb").read(MAX_OUTPUT+1)
    except FileNotFoundError: data=b"NO_UPGRADE_LOG\n"
    if len(data)>MAX_OUTPUT: fail("output_limit_exceeded")
    return {"ok":True,"exitCode":0,"stdout":data.decode("utf-8","replace"),"stderr":""}


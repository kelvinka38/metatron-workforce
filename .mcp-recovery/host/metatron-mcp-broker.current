#!/usr/bin/python3
import base64, concurrent.futures, fcntl, json, os, re, subprocess, sys, time, urllib.error, urllib.request

VERSION = "3.6.0"
ROOTS = {
    "workforce": "/opt/metatron/metatron-workforce",
    "gateway": "/opt/metatron/gateway-g6",
    "telegram": "/opt/metatron/telegram-agent",
    "ssh_mcp": "/opt/metatron/ssh-mcp/build",
}
LOG_CONTAINERS = {"deploy-workforce-1","source-envoy-1","source-cloudflared-1","metatron-ssh-mcp"}
RESTART_CONTAINERS = {"deploy-workforce-1","source-envoy-1","source-cloudflared-1"}
WORKFORCE_ENV_KEYS = ["TELEGRAM_BOT_TOKEN","TELEGRAM_WEBHOOK_SECRET","TELEGRAM_ALLOWED_USER_ID","METATRON_ORGANIZATION_ID","OPENAI_API_KEY","GEMINI_API_KEY","ANTHROPIC_API_KEY","METATRON_LLM_PROVIDER","METATRON_GATEWAY_AUDIT_URL","METATRON_GATEWAY_AUDIT_TOKEN","GITHUB_TOKEN","CLOUDFLARE_API_TOKEN","CLOUDFLARE_ACCOUNT_ID","HETZNER_API_TOKEN"]
MAX_INPUT = 4 * 1024 * 1024
MAX_OUTPUT = 2 * 1024 * 1024
SAFE_PATH = re.compile(r"^[^\x00\r\n]{1,1024}$")
SAFE_QUERY = re.compile(r"^[^\x00\r\n]{1,120}$")
SAFE_MSG = re.compile(r"^[^\x00\r\n]{1,240}$")
SAFE_SHA = re.compile(r"^[0-9a-fA-F]{40}$")

class BrokerError(Exception):
    pass

def fail(msg):
    raise BrokerError(msg)

def read_req():
    raw = sys.stdin.buffer.read(MAX_INPUT + 1)
    if len(raw) > MAX_INPUT: fail("request_too_large")
    try: obj=json.loads(raw.decode("utf-8"))
    except Exception: fail("invalid_json")
    if not isinstance(obj, dict): fail("request_must_be_object")
    if set(obj) != {"op","args"}: fail("request_keys_invalid")
    if not isinstance(obj["op"], str) or not isinstance(obj["args"], dict): fail("request_invalid")
    return obj["op"], obj["args"]

def check_keys(a, allowed, required=()):
    if set(a)-set(allowed): fail("unknown_argument")
    if set(required)-set(a): fail("missing_argument")

def workspace(name, require_git=False):
    if name not in ROOTS: fail("unknown_workspace")
    root=ROOTS[name]
    if os.path.realpath(root)!=root or not os.path.isdir(root): fail("workspace_path_invalid")
    if require_git and not os.path.isdir(os.path.join(root,".git")): fail("not_git_repository")
    return root

def relpath(v, default=None):
    if v is None:
        if default is not None: return default
        fail("path_required")
    if not isinstance(v,str) or not SAFE_PATH.fullmatch(v): fail("invalid_path")
    if v.startswith("/") or "\\" in v or any(p==".." for p in v.split("/")): fail("unsafe_path")
    return v

def run(argv, *, cwd=None, timeout=30, input_data=None, env=None):
    try:
        p=subprocess.run(argv,cwd=cwd,input=input_data,stdout=subprocess.PIPE,stderr=subprocess.PIPE,
                         timeout=timeout,env=env,check=False)
    except subprocess.TimeoutExpired:
        return {"ok":False,"exitCode":124,"stdout":"","stderr":"timeout"}
    out=p.stdout[:MAX_OUTPUT].decode("utf-8","replace")
    err=p.stderr[:MAX_OUTPUT].decode("utf-8","replace")
    return {"ok":p.returncode==0,"exitCode":p.returncode,"stdout":out,"stderr":err}

def sh_fixed(script, timeout=30):
    return run(["/bin/sh","-lc",script],timeout=timeout)

def docker_env(container,key):
    r=run(["/usr/bin/docker","exec",container,"printenv",key],timeout=10)
    return r["stdout"].strip() if r["ok"] else ""

def git_env():
    e=os.environ.copy()
    e.update({"GIT_CONFIG_NOSYSTEM":"1","GIT_TERMINAL_PROMPT":"0","GCM_INTERACTIVE":"Never","GIT_OPTIONAL_LOCKS":"0","LC_ALL":"C.UTF-8"})
    return e

def git(root,args,timeout=30):
    return run(["/usr/bin/git",*args],cwd=root,timeout=timeout,env=git_env())

def broker_identity():
    return {"transport_user":os.environ.get("SUDO_USER",""),"broker_euid":os.geteuid(),"broker_version":VERSION}

def op_server_status(a):
    check_keys(a,[])
    return sh_fixed("printf 'HOST='; hostname; printf 'TRANSPORT_USER=%s\\n' \"$SUDO_USER\"; printf 'BROKER_EUID='; id -u; printf 'BROKER_VERSION=3.6.0\\n'; printf '\\nUPTIME\\n'; uptime; printf '\\nDISK\\n'; df -h /; printf '\\nMEMORY\\n'; free -h")

def op_network_surface_audit(a):
    check_keys(a,[])
    return sh_fixed("echo '=== LISTENING ==='; ss -lntp 2>/dev/null || true; echo; echo '=== DOCKER PUBLISHED PORTS ==='; docker ps --format 'table {{.Names}}\\t{{.Ports}}'; echo; echo '=== UFW ==='; ufw status 2>/dev/null || true")

def op_docker_status(a):
    check_keys(a,[])
    return run(["/usr/bin/docker","ps","--format","table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"])

def op_container_logs(a):
    check_keys(a,["container","lines"],["container"])
    c=a["container"]; lines=a.get("lines",200)
    if c not in LOG_CONTAINERS: fail("container_not_approved")
    if type(lines) is not int or not 1<=lines<=1000: fail("invalid_lines")
    return run(["/usr/bin/docker","logs","--tail",str(lines),c],timeout=20)

def op_workspace_status(a):
    check_keys(a,["workspace"],["workspace"])
    root=workspace(a["workspace"]); chunks=[f"WORKSPACE\n{root}\n"]
    if os.path.isdir(os.path.join(root,".git")):
        for title,args in [("BRANCH",["branch","--show-current"]),("HEAD",["rev-parse","HEAD"]),("STATUS",["status","--short","--branch"]),("LAST COMMIT",["log","-1","--oneline"])]:
            r=git(root,args)
            if not r["ok"]: return r
            chunks.append(f"\n{title}\n{r['stdout']}")
    else: chunks.append("\nNO_GIT_REPOSITORY\n")
    return {"ok":True,"exitCode":0,"stdout":"".join(chunks),"stderr":""}

def op_workspace_list(a):
    check_keys(a,["workspace","path"],["workspace"])
    root=workspace(a["workspace"]); rel=relpath(a.get("path"),".")
    base=os.path.realpath(os.path.join(root,rel))
    if base!=root and not base.startswith(root+os.sep): fail("unsafe_path")
    if not os.path.exists(base): return {"ok":False,"exitCode":1,"stdout":"","stderr":"path_not_found"}
    rows=[]; start_depth=base.rstrip(os.sep).count(os.sep)
    for cur,dirs,files in os.walk(base,topdown=True,followlinks=False):
        depth=cur.rstrip(os.sep).count(os.sep)-start_depth
        if depth>=2: dirs[:]=[]
        for typ,n in [("d",d) for d in dirs]+[("f",f) for f in files]:
            p=os.path.relpath(os.path.join(cur,n),root)
            rows.append(f"{typ} ./{p}")
            if len(rows)>=1000: break
        if len(rows)>=1000: break
    rows.sort()
    return {"ok":True,"exitCode":0,"stdout":"\n".join(rows)+("\n" if rows else ""),"stderr":""}

def op_workspace_read_file(a):
    check_keys(a,["workspace","path"],["workspace","path"])
    root=workspace(a["workspace"]); rel=relpath(a["path"]); p=os.path.realpath(os.path.join(root,rel))
    if not p.startswith(root+os.sep): fail("unsafe_path")
    try: data=open(p,"rb").read(MAX_OUTPUT+1)
    except Exception as e: return {"ok":False,"exitCode":1,"stdout":"","stderr":str(e)}
    if len(data)>MAX_OUTPUT: fail("output_limit_exceeded")
    return {"ok":True,"exitCode":0,"stdout":data.decode("utf-8","replace"),"stderr":""}

def op_workspace_write_file(a):
    check_keys(a,["workspace","path","content_b64"],["workspace","path","content_b64"])
    root=workspace(a["workspace"]); rel=relpath(a["path"])
    if not isinstance(a["content_b64"],str): fail("invalid_content")
    try: data=base64.b64decode(a["content_b64"],validate=True)
    except Exception: fail("invalid_content")
    if len(data)>MAX_INPUT: fail("content_too_large")
    p=os.path.realpath(os.path.join(root,rel))
    if not p.startswith(root+os.sep): fail("unsafe_path")
    os.makedirs(os.path.dirname(p),exist_ok=True)
    # METATRON_MCP_CONTROL_STATE_ATOMIC_V2
    if a["workspace"]=="ssh_mcp" and rel==".runtime-auth-security.enc":
        tmp=p+f".tmp.{os.getpid()}"
        fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)
        try:
            with os.fdopen(fd,"wb",closefd=True) as f:
                f.write(data); f.flush(); os.fsync(f.fileno())
            os.replace(tmp,p); os.chmod(p,0o600)
        finally:
            try:
                if os.path.exists(tmp): os.unlink(tmp)
            except OSError: pass
    else:
        with open(p,"wb") as f: f.write(data)
    return {"ok":True,"exitCode":0,"stdout":f"WROTE {len(data)} bytes to {rel}\n","stderr":""}

def op_workspace_search(a):
    check_keys(a,["workspace","query","path"],["workspace","query"])
    root=workspace(a["workspace"]); q=a["query"]; rel=relpath(a.get("path"),".")
    if not isinstance(q,str) or not SAFE_QUERY.fullmatch(q): fail("invalid_query")
    r=run(["/usr/bin/grep","-Rni","--fixed-strings","--exclude-dir=.git","--exclude-dir=build","--",q,rel],cwd=root,timeout=30)
    if r["exitCode"]==1: return {"ok":True,"exitCode":0,"stdout":"","stderr":""}
    return r

def op_workspace_git_diff(a):
    check_keys(a,["workspace"],["workspace"]); root=workspace(a["workspace"],True)
    s=git(root,["status","--short","--branch"]); d=git(root,["diff","--no-ext-diff"])
    if not s["ok"]: return s
    if not d["ok"]: return d
    return {"ok":True,"exitCode":0,"stdout":s["stdout"]+"\n--- DIFF ---\n"+d["stdout"],"stderr":s["stderr"]+d["stderr"]}

def op_workspace_git_commit_local(a):
    check_keys(a,["message"],["message"]); msg=a["message"]
    if not isinstance(msg,str) or not SAFE_MSG.fullmatch(msg): fail("invalid_commit_message")
    root=workspace("workforce",True); r=git(root,["add","-A"],120)
    if not r["ok"]: return r
    staged=git(root,["diff","--cached","--quiet"],30)
    if staged["exitCode"]==0: return {"ok":True,"exitCode":0,"stdout":"NO_CHANGES_TO_COMMIT\n","stderr":""}
    return git(root,["commit","-m",msg],120)

def op_git_helper(a):
    check_keys(a,["payload"],["payload"])
    if not isinstance(a["payload"],dict): fail("invalid_payload")
    raw=json.dumps(a["payload"],separators=(",",":")).encode()
    if len(raw)>16384: fail("git_helper_request_too_large")
    return run(["/usr/bin/python3","/opt/metatron/ssh-mcp/build/bounded_git_helper.py"],input_data=raw,timeout=35)

def op_workforce_gradle(a):
    check_keys(a,["task"],["task"])
    if a["task"] not in ("test","build"): fail("invalid_task")
    args=["./gradlew"] + (["clean","build"] if a["task"]=="build" else ["test"]) + ["--no-daemon"]
    return run(args,cwd=workspace("workforce"),timeout=900)

def op_workforce_config_presence(a):
    check_keys(a,[])
    rows=[f"{k}={'PRESENT' if docker_env('deploy-workforce-1',k) else 'MISSING'}" for k in WORKFORCE_ENV_KEYS]
    return {"ok":True,"exitCode":0,"stdout":"\n".join(rows)+"\n","stderr":""}

def op_workforce_runtime_credential_audit(a):
    check_keys(a,[])
    rows=[f"{k}={'PRESENT' if docker_env('deploy-workforce-1',k) else 'ABSENT'}" for k in ("GITHUB_TOKEN","GH_TOKEN","GITHUB_PAT")]
    return {"ok":True,"exitCode":0,"stdout":"\n".join(rows)+"\n","stderr":""}

def op_production_identity(a):
    check_keys(a,[]); root=workspace("workforce",True)
    head=git(root,["rev-parse","HEAD"]); br=git(root,["branch","--show-current"])
    ir=run(["/usr/bin/docker","inspect","deploy-workforce-1","--format","{{.Config.Image}}"]); ii=run(["/usr/bin/docker","inspect","deploy-workforce-1","--format","{{.Image}}"])
    for r in (head,br,ir,ii):
        if not r["ok"]: return r
    out=f"LOCAL_HEAD={head['stdout'].strip()}\nLOCAL_BRANCH={br['stdout'].strip()}\nRUNNING_COMMIT={docker_env('deploy-workforce-1','METATRON_COMMIT_SHA')}\nRUNNING_VERSION={docker_env('deploy-workforce-1','METATRON_VERSION')}\nCONTAINER_IMAGE_REF={ir['stdout'].strip()}\nCONTAINER_IMAGE_ID={ii['stdout'].strip()}\n"
    return {"ok":True,"exitCode":0,"stdout":out,"stderr":""}

def op_workforce_health(a):
    check_keys(a,[]); return run(["/usr/bin/curl","-fsS","--max-time","10","http://127.0.0.1:8080/actuator/health"],timeout=15)

def op_gateway_health(a):
    check_keys(a,[]); return run(["/usr/bin/curl","-fsS","--max-time","10","https://gate.metatron.vn/healthz"],timeout=15)

def op_gateway_validate_config(a):
    check_keys(a,[]); return run(["/usr/bin/docker","exec","source-envoy-1","envoy","--mode","validate","-c","/etc/envoy/envoy.yaml"],timeout=120)

def telegram_token():
    t=docker_env("deploy-workforce-1","TELEGRAM_BOT_TOKEN")
    if not t: fail("TELEGRAM_BOT_TOKEN_MISSING")
    return t

def op_telegram_webhook_info(a):
    check_keys(a,[]); t=telegram_token()
    return run(["/usr/bin/curl","-fsS","--max-time","15",f"https://api.telegram.org/bot{t}/getWebhookInfo"],timeout=20)

def op_telegram_route_probe(a):
    check_keys(a,[])
    payload=b'{"update_id":1,"message":{"message_id":1,"from":{"id":1},"chat":{"id":1},"text":"probe"}}'
    req=urllib.request.Request("https://gate.metatron.vn/telegram/webhook",data=payload,method="POST",headers={"Content-Type":"application/json","X-Telegram-Bot-Api-Secret-Token":"metatron-invalid-probe-secret"})
    try:
        urllib.request.urlopen(req,timeout=15); code=200
    except urllib.error.HTTPError as e: code=e.code
    except Exception as e: return {"ok":False,"exitCode":1,"stdout":"","stderr":type(e).__name__}
    ok=code==401
    return {"ok":ok,"exitCode":0 if ok else 1,"stdout":f"HTTP_STATUS={code}\n","stderr":""}

def op_telegram_route_load_probe(a):
    check_keys(a,["concurrency","requests"],["concurrency","requests"]); c=a["concurrency"]; total=a["requests"]
    if c not in (10,50,100,250,500,1000) or type(total) is not int or total<10 or total>5000 or total<c: fail("invalid_load_probe_args")
    url="https://gate.metatron.vn/telegram/webhook"; payload=b'{"update_id":1,"message":{"message_id":1,"from":{"id":1},"chat":{"id":1},"text":"load-probe"}}'
    headers={"Content-Type":"application/json","X-Telegram-Bot-Api-Secret-Token":"metatron-invalid-probe-secret","User-Agent":"curl/8.0"}
    def one(_):
        start=time.perf_counter(); req=urllib.request.Request(url,data=payload,headers=headers,method="POST")
        try:
            with urllib.request.urlopen(req,timeout=15) as r: code=r.status
        except urllib.error.HTTPError as e: code=e.code
        except Exception as e: return ("ERR",time.perf_counter()-start,type(e).__name__)
        return (code,time.perf_counter()-start,"")
    start=time.perf_counter()
    with concurrent.futures.ThreadPoolExecutor(max_workers=c) as ex: rows=list(ex.map(one,range(total)))
    elapsed=time.perf_counter()-start; lat=sorted(r[1]*1000 for r in rows)
    def pct(p):
        i=min(len(lat)-1,max(0,int((p/100)*len(lat))-1)); return lat[i] if lat else 0
    counts={}; errors=[]
    for code,ms,err in rows:
        counts[str(code)]=counts.get(str(code),0)+1
        if code=="ERR": errors.append(err)
        elif code!=401: errors.append(str(code))
    out={"concurrency":c,"requests":total,"elapsed_s":round(elapsed,3),"rps":round(total/elapsed,2),"status_counts":counts,"latency_ms":{"p50":round(pct(50),2),"p95":round(pct(95),2),"p99":round(pct(99),2),"max":round(max(lat),2)},"pass":not errors and counts.get("401",0)==total}
    return {"ok":out["pass"],"exitCode":0 if out["pass"] else 2,"stdout":json.dumps(out,separators=(",",":"))+"\n","stderr":""}

def telegram_post(method, fields):
    t=telegram_token(); args=["/usr/bin/curl","-fsS","--max-time","15","-X","POST",f"https://api.telegram.org/bot{t}/{method}"]
    for k,v in fields: args += ["--data-urlencode",f"{k}={v}"]
    return run(args,timeout=20)

def op_telegram_delete_webhook(a):
    check_keys(a,[]); return telegram_post("deleteWebhook",[("drop_pending_updates","false")])

def op_telegram_set_webhook(a):
    check_keys(a,[]); s=docker_env("deploy-workforce-1","TELEGRAM_WEBHOOK_SECRET")
    if not s: fail("TELEGRAM_WEBHOOK_SECRET_MISSING")
    return telegram_post("setWebhook",[("url","https://gate.metatron.vn/telegram/webhook"),("secret_token",s),("drop_pending_updates","false")])

def op_container_restart(a):
    check_keys(a,["container"],["container"]); c=a["container"]
    if c not in RESTART_CONTAINERS: fail("container_not_approved")
    if c=="deploy-workforce-1": run(["/usr/bin/docker","network","connect","--alias","workforce","metatron-gateway-online",c],timeout=20)
    r=run(["/usr/bin/docker","restart",c],timeout=120)
    if not r["ok"]: return r
    return run(["/usr/bin/docker","ps","--filter",f"name={c}","--format","table {{.Names}}\t{{.Status}}\t{{.Ports}}"])

def op_workforce_deploy_local_sha(a):
    check_keys(a,["sha"],["sha"]); sha=a["sha"]
    if not isinstance(sha,str) or not SAFE_SHA.fullmatch(sha): fail("invalid_sha")
    return run(["/bin/bash","deploy/deploy-production-sha.sh",sha],cwd=workspace("workforce"),timeout=1200)

def op_workforce_verify_production(a):
    check_keys(a,["expected_sha"]); args=["/bin/bash","deploy/verify-production.sh"]
    if "expected_sha" in a:
        sha=a["expected_sha"]
        if not isinstance(sha,str) or not SAFE_SHA.fullmatch(sha): fail("invalid_sha")
        args.append(sha)
    return run(args,cwd=workspace("workforce"),timeout=180)

def op_workforce_rollback(a):
    check_keys(a,[]); return run(["/bin/bash","deploy/rollback-production.sh"],cwd=workspace("workforce"),timeout=1200)


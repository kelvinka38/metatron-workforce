{
  "version": "metatron.coding.v1",
  "owner": "execution",
  "ingresses": [
    "workforce",
    "direct-mcp"
  ],
  "releaseOwner": "highway",
  "stages": [
    {
      "id": "inspect",
      "workerActions": [
        "workspace.repository.materialize",
        "workspace.file.list",
        "workspace.file.search",
        "workspace.file.read",
        "workspace.git.status",
        "workspace.git.diff"
      ],
      "directTools": [
        "repository_open",
        "repository_list",
        "repository_search",
        "repository_read",
        "repository_git_status",
        "repository_git_diff"
      ]
    },
    {
      "id": "mutate",
      "workerActions": [
        "workspace.file.patch",
        "workspace.file.write",
        "workspace.process.run",
        "workspace.shell.run"
      ],
      "directTools": [
        "repository_patch",
        "repository_write",
        "repository_process",
        "repository_shell"
      ]
    },
    {
      "id": "verify",
      "workerActions": [
        "workspace.dependencies.install",
        "workspace.build.run",
        "workspace.test.run"
      ],
      "directTools": [
        "repository_dependencies_install",
        "repository_build",
        "repository_test"
      ]
    },
    {
      "id": "version",
      "workerActions": [
        "workspace.git.run",
        "workspace.github.pr.publish"
      ],
      "directTools": [
        "repository_git_run",
        "repository_pr_publish"
      ]
    },
    {
      "id": "release",
      "workerActions": [],
      "directTools": [
        "workforce_deploy_local_sha",
        "workforce_verify_production",
        "production_identity"
      ]
    }
  ],
  "invariants": {
    "workerReleaseSelfGrant": false,
    "directRequiresWorkforceProcess": true,
    "rawRootShellCanonical": false,
    "sourcePublicationGoverned": true,
    "repositoryCodingUsesObjectiveWorkspace": true,
    "hostWorkspaceToolsAreOperationalCompatibilityOnly": true,
    "repositoryCredentialsRemainInWorkforce": true
  }
}
